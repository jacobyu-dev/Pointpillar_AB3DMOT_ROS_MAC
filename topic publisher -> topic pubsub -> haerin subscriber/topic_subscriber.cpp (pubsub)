#include "ros/ros.h"                          // ROS Default Header File
#include "ros_tutorials_topic/MsgTutorial.h"  // MsgTutorial Message File Header. The header file is automatically created when building the package.

class myClass
{
    public:
    myClass() { 
      pub = nh.advertise<ros_tutorials_topic::MsgTutorial>("haerin_Msg", 100); 
      sub = nh.subscribe("ros_tutorial_msg", 100, &myClass::msgCallback, this); 
    }

    private:
    ros::NodeHandle nh;                                   // Node handle declaration for communication with ROS system
    ros::Publisher pub;
    ros::Subscriber sub;

    void msgCallback(const ros_tutorials_topic::MsgTutorial::ConstPtr& msg) { 
      ROS_INFO("to h send msg = %d", msg->stamp.sec);   // Prints the 'stamp.sec' message
      ROS_INFO("to h send msg = %d", msg->stamp.nsec);  // Prints the 'stamp.nsec' message
      ROS_INFO("to h send msg = %d", msg->data);        // Prints the 'data' message
      
      pub.publish(msg);          // Publishes 'msg' message      
    }
};

int main(int argc, char **argv)                         // Node Main Function
{
  ros::init(argc, argv, "topic_pubsub");            // Initializes Node Name

  myClass myObject;

  // A function for calling a callback function, waiting for a message to be
  // received, and executing a callback function when it is received.
  ros::spin();

  return 0;
}
